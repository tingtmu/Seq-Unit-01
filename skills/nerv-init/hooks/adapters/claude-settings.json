{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.nerv/hooks/raw_guard.py\" --agent claude", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.nerv/hooks/raw_guard.py\" --agent claude", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.nerv/hooks/sync_ratio.py\"", "timeout": 30 }
        ]
      }
    ]
  }
}
